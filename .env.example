# Recourse Phase 0 probes. Copy to .env and fill in. Sandbox only: the probes never call live PayPal.

# Sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox personal account that plays the buyer (used in the dispute PayPal-Auth-Assertion JWT)
BUYER_EMAIL=
# Sandbox personal account that plays the agent operator (invoice recipient, probe 8 vault)
OPERATOR_EMAIL=

CURRENCY=USD

# Local receiver for webhooks and the vault approval redirect (scripts/probes/05-webhook-server.ts)
PORT=8787
RETURN_URL=http://localhost:8787/return
CANCEL_URL=http://localhost:8787/cancel
# Public https URL that forwards to http://localhost:8787/webhook (any tunnel)
WEBHOOK_URL=
# Set to 1 only while sending events from the Webhooks Simulator (those cannot be verified)
WEBHOOK_ALLOW_UNVERIFIED=0

# Optional. Probes save ids to .local/state.json; a value set here wins over the saved one.
# BUYER_VAULT_ID=
# OPERATOR_VAULT_ID=
# CAPTURE_ID=
# DISPUTE_ID=
# WEBHOOK_ID=
# VAULT_USAGE_PATTERN=IMMEDIATE
# DISPUTE_TXN_FIELD=buyer_transaction_id
# SHOW_TOKEN=1
