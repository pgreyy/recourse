    {
      "name": "6 Invoicing v2",
      "description": "Probe 6. Invoice from the merchant to the agent operator.",
      "item": [
        {
          "name": "Generate next invoice number",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const v = pm.response.json().invoice_number; if (v) pm.collectionVariables.set('invoice_number', v); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v2/invoicing/generate-next-invoice-number",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "invoicing",
                "generate-next-invoice-number"
              ]
            }
          }
        },
        {
          "name": "Create invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const v = pm.response.json().id || (pm.response.json().href||'').split('/').pop(); if (v) pm.collectionVariables.set('invoice_id', v); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Prefer",
                "value": "return=representation"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"detail\": {\n    \"invoice_number\": \"{{invoice_number}}\",\n    \"reference\": \"RCS-CASE-TEST\",\n    \"currency_code\": \"{{currency}}\",\n    \"note\": \"Recourse ruling: agent fault. Reimbursement of the buyer refund.\",\n    \"payment_term\": {\n      \"term_type\": \"DUE_ON_RECEIPT\"\n    }\n  },\n  \"invoicer\": {\n    \"business_name\": \"Recourse sandbox merchant\"\n  },\n  \"primary_recipients\": [\n    {\n      \"billing_info\": {\n        \"email_address\": \"{{operator_email}}\"\n      }\n    }\n  ],\n  \"items\": [\n    {\n      \"name\": \"Agent fault liability\",\n      \"quantity\": \"1\",\n      \"unit_amount\": {\n        \"currency_code\": \"{{currency}}\",\n        \"value\": \"25.00\"\n      },\n      \"unit_of_measure\": \"AMOUNT\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v2/invoicing/invoices",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "invoicing",
                "invoices"
              ]
            }
          }
        },
        {
          "name": "Send invoice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"send_to_invoicer\": false,\n  \"send_to_recipient\": true,\n  \"subject\": \"Recourse: agent fault liability invoice (sandbox)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v2/invoicing/invoices/{{invoice_id}}/send",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "invoicing",
                "invoices",
                "{{invoice_id}}",
                "send"
              ]
            }
          }
        },
        {
          "name": "Get invoice",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v2/invoicing/invoices/{{invoice_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "invoicing",
                "invoices",
                "{{invoice_id}}"
              ]
            }
          }
        }
      ]
    },
