        {
          "name": "Create webhook",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const v = pm.response.json().id; if (v) pm.collectionVariables.set('webhook_id', v); }"
                ]
              }
            }
          ],
          "request": {
