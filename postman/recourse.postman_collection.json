    {
      "name": "8 Operator liability charge",
      "description": "Probe 8. Vault the operator with folder 2 (approve as the operator), set operator_vault_id, then charge it here.",
      "item": [
        {
          "name": "Charge operator vault_id (payer not present)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const mandate = JSON.stringify({kind:'recourse.test-mandate', created:new Date().toISOString(), amount:{currency_code:pm.collectionVariables.get('currency'), value:'25.00'}});",
                  "pm.collectionVariables.set('operator_custom_id', CryptoJS.SHA256(mandate).toString());",
                  "pm.collectionVariables.set('operator_invoice_ref', 'RCS-TEST-' + Date.now());",
                  "pm.collectionVariables.set('request_id', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const v = pm.response.json().id; if (v) pm.collectionVariables.set('operator_order_id', v); }",
                  "if (pm.response.code < 300) { const v = (((pm.response.json().purchase_units||[])[0]||{}).payments||{captures:[]}).captures?.[0]?.id; if (v) pm.collectionVariables.set('operator_capture_id', v); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "{{request_id}}"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intent\": \"CAPTURE\",\n  \"purchase_units\": [\n    {\n      \"reference_id\": \"default\",\n      \"description\": \"Recourse: agent checkout, payer not present\",\n      \"custom_id\": \"{{operator_custom_id}}\",\n      \"invoice_id\": \"{{operator_invoice_ref}}\",\n      \"amount\": {\n        \"currency_code\": \"{{currency}}\",\n        \"value\": \"25.00\"\n      }\n    }\n  ],\n  \"payment_source\": {\n    \"paypal\": {\n      \"vault_id\": \"{{operator_vault_id}}\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v2/checkout/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "checkout",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Capture operator order (only if not already COMPLETED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const v = pm.response.json().id; if (v) pm.collectionVariables.set('operator_order_id', v); }",
                  "if (pm.response.code < 300) { const v = (((pm.response.json().purchase_units||[])[0]||{}).payments||{captures:[]}).captures?.[0]?.id; if (v) pm.collectionVariables.set('operator_capture_id', v); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v2/checkout/orders/{{operator_order_id}}/capture",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "checkout",
                "orders",
                "{{operator_order_id}}",
                "capture"
              ]
            }
          }
        },
        {
          "name": "Get operator order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v2/checkout/orders/{{operator_order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "checkout",
                "orders",
                "{{operator_order_id}}"
              ]
            }
          }
        }
      ]
    }
