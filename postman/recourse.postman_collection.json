{
  "info": {
    "name": "Recourse Phase 0 (PayPal sandbox)",
    "description": "Every PayPal sandbox call made by scripts/probes. Fill client_id, client_secret, buyer_email and operator_email, run \"1 Auth / Get access token\", then go folder by folder. Generated by scripts/postman/build.ts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1 Auth",
      "description": "Probe 1. Sets {{access_token}} for every other request.",
      "item": [
        {
          "name": "Get access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const v = pm.response.json().access_token; if (v) pm.collectionVariables.set('access_token', v); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{client_id}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{client_secret}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/oauth2/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "oauth2",
                "token"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2 Vault v3",
      "description": "Probe 2 (buyer) and probe 8 step 1 (operator: approve as the operator sandbox account, then copy vault_id into operator_vault_id).",
      "item": [
        {
          "name": "Create setup token (PayPal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const v = pm.response.json().id; if (v) pm.collectionVariables.set('setup_token_id', v); }",
                  "console.log('approve:', (pm.response.json().links||[]).find(l => l.rel === 'approve')?.href);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_source\": {\n    \"paypal\": {\n      \"description\": \"Recourse: saved PayPal for agent checkout\",\n      \"usage_pattern\": \"IMMEDIATE\",\n      \"usage_type\": \"MERCHANT\",\n      \"customer_type\": \"CONSUMER\",\n      \"permit_multiple_payment_tokens\": false,\n      \"experience_context\": {\n        \"brand_name\": \"Recourse\",\n        \"return_url\": \"{{return_url}}\",\n        \"cancel_url\": \"{{cancel_url}}\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v3/vault/setup-tokens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v3",
                "vault",
                "setup-tokens"
              ]
            }
          }
        },
        {
          "name": "Get setup token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v3/vault/setup-tokens/{{setup_token_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v3",
                "vault",
                "setup-tokens",
                "{{setup_token_id}}"
              ]
            }
          }
        },
        {
          "name": "Create payment token (from setup token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const v = pm.response.json().id; if (v) pm.collectionVariables.set('vault_id', v); }",
                  "if (pm.response.code < 300) { const v = pm.response.json().customer?.id; if (v) pm.collectionVariables.set('customer_id', v); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_source\": {\n    \"token\": {\n      \"id\": \"{{setup_token_id}}\",\n      \"type\": \"SETUP_TOKEN\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v3/vault/payment-tokens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v3",
                "vault",
                "payment-tokens"
              ]
            }
          }
        },
        {
          "name": "Get payment token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v3/vault/payment-tokens/{{vault_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v3",
                "vault",
                "payment-tokens",
                "{{vault_id}}"
              ]
            }
          }
        },
        {
          "name": "List customer payment tokens",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v3/vault/payment-tokens?customer_id={{customer_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v3",
                "vault",
                "payment-tokens"
              ],
              "query": [
                {
                  "key": "customer_id",
                  "value": "{{customer_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Fallback: create setup token (sandbox card)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const v = pm.response.json().id; if (v) pm.collectionVariables.set('setup_token_id', v); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_source\": {\n    \"card\": {\n      \"name\": \"Sandbox Tester\",\n      \"number\": \"4111111111111111\",\n      \"expiry\": \"2030-12\",\n      \"security_code\": \"123\",\n      \"verification_method\": \"SCA_WHEN_REQUIRED\",\n      \"billing_address\": {\n        \"address_line_1\": \"1 Main St\",\n        \"admin_area_2\": \"San Jose\",\n        \"admin_area_1\": \"CA\",\n        \"postal_code\": \"95131\",\n        \"country_code\": \"US\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v3/vault/setup-tokens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v3",
                "vault",
                "setup-tokens"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3 Orders v2 (vault, payer not present)",
      "description": "Probe 3. custom_id is the sha256 hex of a stand-in mandate, set by the pre-request script.",
      "item": [
        {
          "name": "Create order with vault_id",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const mandate = JSON.stringify({kind:'recourse.test-mandate', created:new Date().toISOString(), amount:{currency_code:pm.collectionVariables.get('currency'), value:'25.00'}});",
                  "pm.collectionVariables.set('custom_id', CryptoJS.SHA256(mandate).toString());",
                  "pm.collectionVariables.set('invoice_ref', 'RCS-TEST-' + Date.now());",
                  "pm.collectionVariables.set('request_id', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const v = pm.response.json().id; if (v) pm.collectionVariables.set('order_id', v); }",
                  "if (pm.response.code < 300) { const v = (((pm.response.json().purchase_units||[])[0]||{}).payments||{captures:[]}).captures?.[0]?.id; if (v) pm.collectionVariables.set('capture_id', v); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "{{request_id}}"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intent\": \"CAPTURE\",\n  \"purchase_units\": [\n    {\n      \"reference_id\": \"default\",\n      \"description\": \"Recourse: agent checkout, payer not present\",\n      \"custom_id\": \"{{custom_id}}\",\n      \"invoice_id\": \"{{invoice_ref}}\",\n      \"amount\": {\n        \"currency_code\": \"{{currency}}\",\n        \"value\": \"25.00\"\n      }\n    }\n  ],\n  \"payment_source\": {\n    \"paypal\": {\n      \"vault_id\": \"{{vault_id}}\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v2/checkout/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "checkout",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Capture order (only if not already COMPLETED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const v = pm.response.json().id; if (v) pm.collectionVariables.set('order_id', v); }",
                  "if (pm.response.code < 300) { const v = (((pm.response.json().purchase_units||[])[0]||{}).payments||{captures:[]}).captures?.[0]?.id; if (v) pm.collectionVariables.set('capture_id', v); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v2/checkout/orders/{{order_id}}/capture",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "checkout",
                "orders",
                "{{order_id}}",
                "capture"
              ]
            }
          }
        },
        {
          "name": "Get order (check custom_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pu = (pm.response.json().purchase_units||[])[0]||{};",
                  "console.log('custom_id sent:', pm.collectionVariables.get('custom_id'), 'returned:', pu.custom_id, pu.custom_id === pm.collectionVariables.get('custom_id') ? 'MATCH' : 'MISMATCH');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v2/checkout/orders/{{order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "checkout",
                "orders",
                "{{order_id}}"
              ]
            }
          }
        },
        {
          "name": "Get capture",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v2/payments/captures/{{capture_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "payments",
                "captures",
                "{{capture_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4 Disputes",
      "description": "Probe 4. Create is sandbox only and acts as the buyer through an unsigned PayPal-Auth-Assertion JWT. require-evidence and adjudicate are sandbox only.",
      "item": [
        {
          "name": "Create dispute (sandbox, as buyer)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b64 = (o) => CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(JSON.stringify(o))).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "pm.collectionVariables.set('auth_assertion', b64({alg:'none',typ:'JWT'}) + '.' + b64({iss: pm.collectionVariables.get('client_id'), email: pm.collectionVariables.get('buyer_email')}) + '.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const v = (pm.response.json().links||[]).find(l => l.rel === 'self')?.href.split('/').pop(); if (v) pm.collectionVariables.set('dispute_id', v); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Auth-Assertion",
                "value": "{{auth_assertion}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "input",
                  "value": "{\n  \"disputed_transactions\": [\n    {\n      \"buyer_transaction_id\": \"{{capture_id}}\"\n    }\n  ],\n  \"reason\": \"MERCHANDISE_OR_SERVICE_NOT_AS_DESCRIBED\",\n  \"dispute_amount\": {\n    \"currency_code\": \"{{currency}}\",\n    \"value\": \"25.00\"\n  },\n  \"extensions\": {\n    \"merchant_contacted\": false,\n    \"merchandize_dispute_properties\": {\n      \"issue_type\": \"PRODUCT\"\n    }\n  }\n}",
                  "type": "text",
                  "contentType": "application/json"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/customer/disputes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "customer",
                "disputes"
              ]
            }
          }
        },
        {
          "name": "List disputes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/customer/disputes?page_size=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "customer",
                "disputes"
              ],
              "query": [
                {
                  "key": "page_size",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Get dispute (status + links)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json(); console.log(d.status, (d.links||[]).map(l => l.rel).join(', '));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/customer/disputes/{{dispute_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "customer",
                "disputes",
                "{{dispute_id}}"
              ]
            }
          }
        },
        {
          "name": "Accept claim",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Recourse: accepting claim.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/customer/disputes/{{dispute_id}}/accept-claim",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "customer",
                "disputes",
                "{{dispute_id}}",
                "accept-claim"
              ]
            }
          }
        },
        {
          "name": "Provide evidence (multipart)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "input",
                  "value": "{\n  \"evidences\": [\n    {\n      \"evidence_type\": \"PROOF_OF_FULFILLMENT\",\n      \"notes\": \"Signed mandate and receipt attached.\"\n    }\n  ]\n}",
                  "type": "text",
                  "contentType": "application/json"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/customer/disputes/{{dispute_id}}/provide-evidence",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "customer",
                "disputes",
                "{{dispute_id}}",
                "provide-evidence"
              ]
            },
            "description": "Add a file part named evidence-file (PDF/PNG/JPG/GIF) in the Body tab."
          }
        },
        {
          "name": "Make offer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Recourse: partial refund offer.\",\n  \"offer_amount\": {\n    \"currency_code\": \"{{currency}}\",\n    \"value\": \"5.00\"\n  },\n  \"offer_type\": \"REFUND\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/customer/disputes/{{dispute_id}}/make-offer",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "customer",
                "disputes",
                "{{dispute_id}}",
                "make-offer"
              ]
            }
          }
        },
        {
          "name": "Send message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Recourse message.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/customer/disputes/{{dispute_id}}/send-message",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "customer",
                "disputes",
                "{{dispute_id}}",
                "send-message"
              ]
            }
          }
        },
        {
          "name": "Escalate (as buyer)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b64 = (o) => CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(JSON.stringify(o))).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "pm.collectionVariables.set('auth_assertion', b64({alg:'none',typ:'JWT'}) + '.' + b64({iss: pm.collectionVariables.get('client_id'), email: pm.collectionVariables.get('buyer_email')}) + '.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "PayPal-Auth-Assertion",
                "value": "{{auth_assertion}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Recourse: escalating to claim.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/customer/disputes/{{dispute_id}}/escalate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "customer",
                "disputes",
                "{{dispute_id}}",
                "escalate"
              ]
            }
          }
        },
        {
          "name": "Require evidence (sandbox only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"SELLER_EVIDENCE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/customer/disputes/{{dispute_id}}/require-evidence",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "customer",
                "disputes",
                "{{dispute_id}}",
                "require-evidence"
              ]
            }
          }
        },
        {
          "name": "Adjudicate (sandbox only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"adjudication_outcome\": \"BUYER_FAVOR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/customer/disputes/{{dispute_id}}/adjudicate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "customer",
                "disputes",
                "{{dispute_id}}",
                "adjudicate"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5 Webhooks",
      "description": "Probe 5. Event types: CUSTOMER.DISPUTE.CREATED, CUSTOMER.DISPUTE.UPDATED, INVOICING.INVOICE.PAID, PAYMENT.CAPTURE.REFUNDED.",
      "item": [
        {
