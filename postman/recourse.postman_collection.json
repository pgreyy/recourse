            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{webhook_url}}\",\n  \"event_types\": [\n    {\n      \"name\": \"CUSTOMER.DISPUTE.CREATED\"\n    },\n    {\n      \"name\": \"CUSTOMER.DISPUTE.UPDATED\"\n    },\n    {\n      \"name\": \"INVOICING.INVOICE.PAID\"\n    },\n    {\n      \"name\": \"PAYMENT.CAPTURE.REFUNDED\"\n    }\n  ]\n}",
              "options": {
